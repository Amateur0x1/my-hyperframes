# ── 依赖 ──────────────────────────────────────────
node_modules/
.pnp.*
.yarn/

# ── 渲染产物 ──────────────────────────────────────
# 帧序列动辄上万张，永远不要进版本库
**/frames/
**/out/
**/output/

# 成片（如果你要保留源素材视频，放到 assets/ 并在这里加 !assets/**）
**/*.mp4
**/*.webm
**/*.mov

# ── 临时文件 ──────────────────────────────────────
*.tmp
*.temp
**/.cache/
**/tmp/

# ── 日志与调试 ────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 环境变量与密钥 ────────────────────────────────
.env
.env.*
!.env.example

# ── 系统 / 编辑器 ─────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
